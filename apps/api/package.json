{
  "name": "@armurier/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:drop": "drizzle-kit drop",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:seed:demo": "tsx src/db/seed-cli.ts --demo",
    "media:backfill-avif": "tsx src/media/backfill-avif-cli.ts",
    "media:backfill-og": "tsx src/media/backfill-og-cli.ts",
    "e2e:server": "tsx src/e2e/server.ts",
    "sla:check": "tsx src/legal-documents/sla-cli.ts",
    "orders:confirmations": "tsx src/orders/confirmations-cli.ts",
    "tracking:sync": "tsx src/shipments/tracking/tracking-cli.ts",
    "henrri:check": "tsx src/henrri/check-cli.ts",
    "auth:totp-reset": "tsx src/auth/totp-reset-cli.ts",
    "henrri:sync": "tsx src/henrri/sync-cli.ts",
    "catalog:images": "tsx src/catalog-import/images-cli.ts"
  },
  "dependencies": {
    "@armurier/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/s3-request-presigner": "3.1101.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/jwt": "10.2.1",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@node-rs/argon2": "2.0.2",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.6",
    "nodemailer": "10.1.4",
    "pg": "8.22.0",
    "pino-pretty": "13.1.3",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "stripe": "22.4.0",
    "tsx": "4.23.1",
    "uqr": "0.1.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "8.20.3",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "0.31.10",
    "form-data": "^4.0.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  }
}
