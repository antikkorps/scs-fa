{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "90 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days",
    "labels": ["security"]
  },
  "customManagers": [
    {
      "description": "Keep the biome.json $schema URL in sync with the @biomejs/biome version",
      "customType": "regex",
      "managerFilePatterns": ["biome.json"],
      "matchStrings": ["https://biomejs\\.dev/schemas/(?<currentValue>[^/\"]+)/schema\\.json"],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm"
    },
    {
      "description": "Keep the corepack the Dockerfiles install (Node 25+ no longer ships it) up to date",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["npm install -g corepack@(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "corepack",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Group non-major npm updates into a single PR per ecosystem",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major"
    },
    {
      "description": "Group devDependency major updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "devDeps major"
    },
    {
      "description": "Group CI action updates into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "ci actions"
    },
    {
      "description": "exceljs is CommonJS and requires uuid; uuid 12+ is ESM-only, so the override stays on 11.x",
      "matchDepNames": ["exceljs>uuid"],
      "allowedVersions": "<12"
    },
    {
      "description": "Security overrides scoped to a vulnerable range (\"pkg@<x.y.z\") pin the fixed release of the same major; a major bump would hand the parent an incompatible dependency",
      "matchDepNames": ["/@[<>=]/"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "One Node.js runtime everywhere (CI, Docker images, .nvmrc, engines), moved together and only to an even (LTS-track) major: CI must test what production runs",
      "matchDepNames": ["node"],
      "groupName": "node runtime",
      "allowedVersions": "/^v?\\d*[02468](\\.|-|$)/"
    }
  ]
}
